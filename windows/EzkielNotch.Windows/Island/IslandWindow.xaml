<Window x:Class="EzkielNotch.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EzkielNotch.Island"
        Title="Ezkiel Notch"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="Manual" Width="520" Height="320"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- One accent per room, the same light→deep pairs as the Mac app. -->
        <SolidColorBrush x:Key="Ink" Color="#F5F1EA"/>
        <SolidColorBrush x:Key="Mist" Color="#8FFFFFFF"/>
        <SolidColorBrush x:Key="Faint" Color="#57FFFFFF"/>
        <SolidColorBrush x:Key="Surface" Color="#0DFFFFFF"/>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    </Window.Resources>

    <Grid x:Name="Root">
        <local:IslandSurface x:Name="Island" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid x:Name="Body" ClipToBounds="True">

                <!-- Peek: one line under the top edge, like a Whisker on the Mac. -->
                <Grid x:Name="PeekView" Opacity="0" Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="/Assets/lion.png" Width="26" Height="26" Margin="0,0,10,0"/>
                        <TextBlock x:Name="PeekTitle" Text="Ezkiel Notch" FontFamily="{StaticResource Text}" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PeekSubtitle" Text="" FontFamily="{StaticResource Text}" FontSize="12"
                                   Foreground="{StaticResource Mist}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Expanded: header, the rooms, and the page. -->
                <Grid x:Name="ExpandedView" Opacity="0" Margin="14,0,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <Image Source="/Assets/lion.png" Width="20" Height="20" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TabTitle" Text="Den" Margin="8,0,0,0" FontFamily="{StaticResource Text}" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <Button x:Name="CloseButton" DockPanel.Dock="Right" Width="24" Height="24" Cursor="Hand" ToolTip="Close (Esc)"
                                Click="OnCloseClick" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" CornerRadius="12" Background="#12FFFFFF">
                                        <TextBlock Text="&#xE70E;" FontFamily="{StaticResource Icons}" FontSize="10"
                                                   Foreground="{StaticResource Mist}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#24FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock x:Name="Clock" Text="00:00" DockPanel.Dock="Right" Margin="0,0,10,0" FontFamily="{StaticResource Text}"
                                   FontSize="12" Foreground="{StaticResource Mist}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <UniformGrid x:Name="Tabs" Grid.Row="1" Rows="1"/>

                    <Border Grid.Row="2" Margin="0,10,0,0" CornerRadius="14" Background="{StaticResource Surface}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                            <Image Source="/Assets/lion.png" Width="56" Height="56" Margin="0,0,14,0"/>
                            <StackPanel VerticalAlignment="Center" MaxWidth="260">
                                <TextBlock x:Name="PageTitle" Text="Phase 0 preview" FontFamily="{StaticResource Text}" FontSize="15"
                                           FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                <TextBlock x:Name="PageBody" TextWrapping="Wrap" Margin="0,3,0,0" FontFamily="{StaticResource Text}" FontSize="12"
                                           Foreground="{StaticResource Mist}"
                                           Text="Shape, motion, hover and click-through. The rooms arrive in Phase 1."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </local:IslandSurface>
    </Grid>
</Window>
