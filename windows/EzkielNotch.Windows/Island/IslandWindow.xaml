<Window x:Class="EzkielNotch.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EzkielNotch.Island"
        Title="Ezkiel Notch"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="Manual" Width="520" Height="320"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- One accent per room, the same light→deep pairs as the Mac app. -->
        <SolidColorBrush x:Key="Ink" Color="#F5F1EA"/>
        <SolidColorBrush x:Key="Mist" Color="#8FFFFFFF"/>
        <SolidColorBrush x:Key="Faint" Color="#57FFFFFF"/>
        <SolidColorBrush x:Key="Surface" Color="#0DFFFFFF"/>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    </Window.Resources>

    <Grid x:Name="Root">
        <local:IslandSurface x:Name="Island" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid x:Name="Body" ClipToBounds="True">

                <!-- Peek: one line under the top edge, like a Whisker on the Mac. -->
                <Grid x:Name="PeekView" Opacity="0" Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image x:Name="PeekIcon" Source="/Assets/lion.png" Width="26" Height="26" Margin="0,0,10,0"/>
                        <TextBlock x:Name="PeekTitle" Text="Ezkiel Notch" FontFamily="{StaticResource Text}" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PeekSubtitle" Text="" FontFamily="{StaticResource Text}" FontSize="12" MaxWidth="200"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource Mist}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <StackPanel x:Name="PeekActions" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Closed but live: the Mac's wings, as a small pill (a timer, music, Prowl, unread…). -->
                <Grid x:Name="LiveView" Opacity="0" IsHitTestVisible="False" Margin="12,0">
                    <StackPanel x:Name="LiveLeft" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <StackPanel x:Name="LiveRight" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <ContentControl x:Name="LiveCenter" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/>
                </Grid>

                <!-- Expanded: header, the rooms, and the page. -->
                <Grid x:Name="ExpandedView" Opacity="0" Margin="14,0,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <Image Source="/Assets/lion.png" Width="20" Height="20" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TabTitle" Text="Den" Margin="8,0,0,0" FontFamily="{StaticResource Text}" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="TabSubtitle" Text="" Margin="8,1,0,0" FontFamily="{StaticResource Text}" FontSize="12"
                                   Foreground="{StaticResource Faint}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <Button x:Name="CloseButton" DockPanel.Dock="Right" Width="24" Height="24" Cursor="Hand" ToolTip="Close (Esc)"
                                Click="OnCloseClick" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" CornerRadius="12" Background="#12FFFFFF">
                                        <TextBlock Text="&#xE70E;" FontFamily="{StaticResource Icons}" FontSize="10"
                                                   Foreground="{StaticResource Mist}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#24FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel x:Name="WeatherChip" Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,0,10,0"
                                    VerticalAlignment="Center" Visibility="Collapsed" Background="Transparent"/>
                        <TextBlock x:Name="Clock" Text="00:00" DockPanel.Dock="Right" Margin="0,0,10,0" FontFamily="{StaticResource Text}"
                                   FontSize="12" Foreground="{StaticResource Mist}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <UniformGrid x:Name="Tabs" Grid.Row="1" Rows="1"/>

                    <!-- The room's page, at its own height; toasts float over its bottom edge. -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Border x:Name="PageHost" VerticalAlignment="Top"/>
                        <!-- Mirror: the camera, over the page, only while it's open. -->
                        <Border x:Name="MirrorView" VerticalAlignment="Top" CornerRadius="14" Background="#FF0E0E10" Visibility="Collapsed" ClipToBounds="True"/>
                        <Border x:Name="ToastView" VerticalAlignment="Bottom" HorizontalAlignment="Center" Opacity="0" IsHitTestVisible="False"
                                Height="30" CornerRadius="15" Background="#F22C2C2E" Padding="14,0,6,0" Margin="0,0,0,2">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Color="Black"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ToastText" FontFamily="{StaticResource Text}" FontSize="12" Foreground="{StaticResource Ink}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                <Border x:Name="ToastAction"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </local:IslandSurface>
    </Grid>
</Window>
