<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 19041 = Windows 10 2004: the oldest build with every WinRT API the later phases use. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Lets the project build on macOS/Linux too (CI and development); it only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- LibraryImport generates the P/Invoke marshalling at compile time; it needs this. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>EzkielNotch</AssemblyName>
    <RootNamespace>EzkielNotch</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Version>0.1.0</Version>
    <Product>Ezkiel Notch</Product>
    <Company>Ezkielyna Store</Company>
    <Copyright>Ezkielyna Store · ezkielyna.store</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\lion.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
